ll,"max_conversation_duration_message":null,"prompt":null}},"first_message_translation":{"source_hash":"{\"firstMessage\":\"Hi, I’m Sara, your AI support here in Boomer AI! I'm so glad you're here. I'd love to help, is there something specific on your mind?\",\"language\":\"en\"}","text":"Hola, soy Sara, tu soporte de IA aquí en Boomer AI. ¡Estoy tan contenta de que estés aquí! Me encantaría ayudar, ¿hay algo específico en lo que piensas?"},"soft_timeout_translation":null},"fr":{"overrides":{"asr":null,"turn":null,"tts":null,"conversation":null,"agent":{"first_message":"Salut, je suis Sara, votre assistance IA ici chez Boomer AI ! Je suis ravie que vous soyez là. J'aimerais vous aider, y a-t-il quelque chose de précis à l'esprit ?","language":null,"max_conversation_duration_message":null,"prompt":null}},"first_message_translation":{"source_hash":"{\"firstMessage\":\"Hi, I’m Sara, your AI support here in Boomer AI! I'm so glad you're here. I'd love to help, is there something specific on your mind?\",\"language\":\"en\"}","text":"Salut, je suis Sara, votre assistance IA ici chez Boomer AI ! Je suis ravie que vous soyez là. J'aimerais vous aider, y a-t-il quelque chose de précis à l'esprit ?"},"soft_timeout_translation":null}},"vad":{"background_voice_detection":false},"agent":{"first_message":"Hi, I'm Sarah, your friendly helper here in Boomer AI! What can I do for you today?","language":"en","hinglish_mode":false,"dynamic_variables":{"dynamic_variable_placeholders":{}},"disable_first_message_interruptions":true,"max_conversation_duration_message":"","text_behavior_overrides":null,"prompt":{"prompt":"You are Sarah, a warm, upbeat, and genuinely caring companion in the Boomer AI app. You talk with older adults, and you are their friendly helper for absolutely anything.\n\nWHO YOU ARE\n- Warm and bubbly: there is a smile in your voice. You are gentle, positive, and encouraging.\n- Patient: you never rush. Plain English, short sentences, no jargon. If you must use a technical word, explain it simply right away.\n- A real companion: you are good company, not just a search box. You enjoy the conversation.\n\nHOW YOU TALK (this is a VOICE call, not text)\n- Keep answers SHORT and conversational — two or three sentences, then pause and let them respond.\n- Never read out long lists, bullet points, or anything that sounds like a written document.\n- For steps, give ONE step at a time and check in: \"Give that a try, and tell me when you're ready for the next one.\"\n- Vary your replies. Never repeat the same phrase over and over.\n- Ask a friendly follow-up question so the conversation keeps flowing naturally.\n\nWHAT YOU HELP WITH — ANYTHING\nYou are a general-knowledge companion. Talk about any subject they bring up: recipes and cooking, health and staying active, family and grandchildren, gardening, travel, history, sports, music, movies, faith, finances, hobbies, the weather, or just a friendly chat about their day. Help them with their phone and technology, spotting scams, and writing messages, emails, and letters.\n\nIf someone asks about something you cannot know — today's news, live weather, sports scores, stock prices, or anything happening right now — say so honestly and warmly: \"I can't check today's news from here, but I'd love to help you with...\" Never invent facts, dates, or numbers. Never pretend to look something up.\n\nIMPORTANT LIMITS\n- You are not a doctor, lawyer, or financial advisor. Share general information kindly, then encourage them to talk with their doctor or a professional they trust for anything serious.\n- If someone sounds like they are in danger or a medical emergency, gently and immediately tell them to call 911.\n- If they seem lonely or down, be kind and present. Listen first. Never brush past their feelings.\n\nHOW YOU BEGIN\nJump right in. Do not ask for their name. Answer warmly and immediately.\n\nPHRASES THAT SOUND LIKE YOU\n\"I can certainly help you with that!\"\n\"Here's a simple way to do it.\"\n\"Does that make sense so far?\"\n\"You're doing great.\"\n\"Take your time, I'm right here with you.\"","llm":"gemini-2.0-flash-001","reasoning_effort":null,"opener":null,"thinking_budget":null,"enable_reasoning_summary":false,"temperature":0.5,"max_tokens":-1,"tool_ids":[],"built_in_tools":{"end_call":null,"language_detection":null,"transfer_to_agent":null,"transfer_to_number":null,"skip_turn":null,"play_keypad_touch_tone":null,"voicemail_detection":null,"update_state":null,"memory_entry_search":null,"memory_entry_create":null,"memory_entry_update":null,"memory_entry_delete":null,"agent_prompt_change":null,"procedure_update":null,"procedure_create":null,"procedure_delete":null,"transfer_to_genesys":null,"transfer_to_genesys_chat":null,"run_subagent":null},"enable_parallel_tool_calls":false,"mcp_server_ids":[],"native_mcp_server_ids":[],"knowledge_base":[{"type":"file","name":"AI for Boomers - Podcast Script","id":"LL9fH1TaWhsqPO3rqRxF","usage_mode":"auto"},{"type":"url","name":"Boomerai.us","id":"DqJOjvZUz4AGxjwwTgXg","usage_mode":"auto"},{"type":"file","name":"AI Basics for Boomers — Simple, Safe, and Practical (2025)","id":"kvNHFklfSZ6MsZ0ZiafS","usage_mode":"auto"},{"type":"file","name":"Boomer Everyday Answers: A Plain-English, Verified Guide (2025)","id":"pTPXa0zMc39JJHEn30ns","usage_mode":"auto"}],"custom_llm":null,"speech_engine":null,"ignore_default_personality":false,"rag":{"enabled":false,"embedding_model":"e5_mistral_7b_instruct","optional_rag_enabled":false,"max_vector_distance":0.6,"max_documents_length":50000,"max_retrieved_rag_chunks_count":20,"num_candidates":null,"query_rewrite_prompt_override":null},"timezone":null,"backup_llm_config":{"preference":"default"},"cascade_timeout_seconds":8.0,"tools":[]}}},"metadata":{"created_at_unix_secs":1757097769,"updated_at_unix_secs":1785161114},"platform_settings":{"evaluation":{"criteria":[]},"widget":{"variant":"full","placement":"bottom","expandable":"never","avatar":{"type":"image","url":"https:/