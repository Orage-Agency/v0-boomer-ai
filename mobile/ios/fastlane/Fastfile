default_platform(:ios)

BUNDLE_ID     = "boomerai.orage.agency"
PROFILE_NAME  = "match AppStore #{BUNDLE_ID}"
SCHEME        = "BoomerAI"
WORKSPACE     = "BoomerAI.xcworkspace"
PROJECT       = "BoomerAI.xcodeproj"
TF_GROUP_ID   = "6162d862-da50-4650-b96d-8f55ea851ef5"
TF_GROUP_NAME = "BOOMER AI V1"

platform :ios do
  desc "Build and upload to TestFlight via ASC API key"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id:        ENV.fetch("ASC_KEY_ID"),
      issuer_id:     ENV.fetch("ASC_ISSUER_ID"),
      key_filepath:  ENV.fetch("ASC_KEY_FILEPATH"),
      in_house:      false,
    )

    match(
      type:                  "appstore",
      readonly:              false,
      api_key:               api_key,
      force_for_new_devices: false,
    )

    next_build = (latest_testflight_build_number(
      api_key:              api_key,
      app_identifier:       BUNDLE_ID,
      initial_build_number: 0,
    ).to_i + 1)
    UI.message("Next build number: #{next_build}")

    increment_build_number(
      build_number: next_build,
      xcodeproj:    PROJECT,
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  PROJECT,
      team_id:               ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier:     BUNDLE_ID,
      profile_name:          PROFILE_NAME,
      code_sign_identity:    "Apple Distribution",
      targets:               ["BoomerAI"],
    )

    build_app(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    "Release",
      clean:            true,
      output_directory: "build",
      output_name:      "BoomerAI.ipa",
      export_method:    "app-store",
      export_options:   {
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
        signingStyle:         "manual",
        signingCertificate:   "Apple Distribution",
      },
      xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(
      api_key:                          api_key,
      ipa:                              "build/BoomerAI.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission:                  true,
    )
  end
end