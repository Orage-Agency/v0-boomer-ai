# Mobile env — copy to `.env.local` (gitignored) and fill in.
# These are read at Expo build time via `process.env.EXPO_PUBLIC_*`.

# RevenueCat public SDK keys (iOS starts with `appl_`, Android with `goog_`).
# Sandbox key for iOS is stored in the Orage vault; use the sandbox key for
# TestFlight / sandbox-account purchases, the production key for App Store
# release.
EXPO_PUBLIC_RC_IOS_KEY=__REPLACE_ME__
EXPO_PUBLIC_RC_ANDROID_KEY=__REPLACE_ME__

# Optional for a physical device on the same LAN as the Next.js dev server.
# iOS Simulator and web default to localhost:3000; Android Emulator defaults
# to 10.0.2.2:3000. Set a private LAN URL only for a physical device.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000
