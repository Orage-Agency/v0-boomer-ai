{
  "$schema": "https://json.schemastore.org/eas-config.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "credentialsSource": "local",
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6755741429",
        "appleTeamId": "HU749X2FPS"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6755741429",
        "appleTeamId": "HU749X2FPS"
      }
    }
  }
}
